    {
      "name": "4. Update Resource (PUT /books/:id)",
      "item": [
        {
          "name": "4.1 PUT Update Existing Book (Success 200 OK)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Architecting Scalable Backend Systems (Revised)\",\n  \"author\": \"Mr Sai Siva Teja Chintakrindi\",\n  \"price\": 49.99,\n  \"genre\": \"Enterprise Engineering\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books/{{createdBookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{createdBookId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK after update', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Updated details reflected', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.title).to.include('(Revised)');",
                  "    pm.expect(json.data.price).to.equal(49.99);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
