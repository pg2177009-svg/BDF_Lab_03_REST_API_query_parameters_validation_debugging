    {
      "name": "3. Create & Validation (POST /books)",
      "item": [
        {
          "name": "3.1 POST Create Book (Success 201 Created)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Architecting Scalable Backend Systems\",\n  \"author\": \"Mr Sai Siva Teja Chintakrindi\",\n  \"price\": 45.00,\n  \"genre\": \"System Architecture\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Book created and ID returned', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('data');",
                  "    pm.expect(json.data.id).to.be.a('number');",
                  "    pm.collectionVariables.set('createdBookId', json.data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
