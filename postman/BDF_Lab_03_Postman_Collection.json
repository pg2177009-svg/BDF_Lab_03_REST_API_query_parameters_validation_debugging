  "item": [
    {
      "name": "1. Query Parameters & Filters (GET /books)",
      "item": [
        {
          "name": "1.1 GET All Books (Default query params)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response contains pagination and book array', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('data').that.is.an('array');",
                  "    pm.expect(json).to.have.property('limit', 10);",
                  "    pm.expect(json).to.have.property('offset', 0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.2 GET Books by Title Search (search_q=Clean)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?search_q=Clean",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "search_q", "value": "Clean" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Every returned book matches search query', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.length).to.be.above(0);",
                  "    json.data.forEach(b => pm.expect(b.title.toLowerCase()).to.include('clean'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.3 GET Books Sorted by Price DESC (order_by=price&order=DESC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?order_by=price&order=DESC",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "order_by", "value": "price" },
                { "key": "order", "value": "DESC" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Books are sorted descending by price', function () {",
                  "    const json = pm.response.json();",
                  "    for (let i = 0; i < json.data.length - 1; i++) {",
                  "        pm.expect(json.data[i].price).to.be.at.least(json.data[i+1].price);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.4 GET Books within Price Range (min_price=20&max_price=40)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?min_price=20&max_price=40",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "min_price", "value": "20" },
                { "key": "max_price", "value": "40" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('All books fall within price boundaries', function () {",
                  "    const json = pm.response.json();",
                  "    json.data.forEach(b => {",
                  "        pm.expect(b.price).to.be.at.least(20);",
                  "        pm.expect(b.price).to.be.at.most(40);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.5 GET Books with Pagination (limit=3&offset=3)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?limit=3&offset=3",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "limit", "value": "3" },
                { "key": "offset", "value": "3" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Limit and offset are respected', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.length).to.equal(3);",
                  "    pm.expect(json.limit).to.equal(3);",
                  "    pm.expect(json.offset).to.equal(3);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.6 [Failure] Reject Invalid Order Column (order_by=invalid)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?order_by=hacked_column",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "order_by", "value": "hacked_column" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Consistent error message returned', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('message');",
                  "    pm.expect(json.message).to.include('order_by must be one of');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.7 [Failure] Reject Invalid Price Range (min_price > max_price)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?min_price=60&max_price=30",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "min_price", "value": "60" },
                { "key": "max_price", "value": "30" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Consistent error message returned', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('message');",
                  "    pm.expect(json.message).to.include('min_price cannot be greater than max_price');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
